# Claude Configuration Git Ignore

# System files
.DS_Store
Thumbs.db

# Sensitive and local configuration
.env
.env.local
settings*.json
settings*.json.bak
*.backup

# History and session data
history.jsonl
session-env/
shell-snapshots/
file-history/

# Cache and temporary files
cache/
debug/
downloads/
ide/
logs/
paste-cache/
todos/

# Telemetry and statistics
telemetry/
stats-cache.json
statsig/

# Python bytecode caches (e.g. from uv-run skill scripts)
__pycache__/
*.pyc

# AutoFigure-Edit Python virtual environment
skills/paper-figure-generator/scripts/.venv/
# Legacy clone directory (if exists)
skills/paper-figure-generator/.autofigure-edit/

# claude-mem auto-generated CLAUDE.md files (can appear in any subdirectory)
# Broad ignore + explicit whitelist for intentional CLAUDE.md files
**/CLAUDE.md
!/CLAUDE.md
!/policy/CLAUDE.md

# Codex directory — only allow INSTALL.md
.codex/*
!.codex/INSTALL.md

# Other temporary files
docs/*
!docs/orchestrator.md
plan/
plans/
projects/
temp/

# Plugin marketplace clones are nested git repos, not submodules of this
# repo. Committed as bare gitlinks they had no .gitmodules entries, so every
# `git submodule` call — including the one `git clone --recurse-submodules`
# makes — died with "No url found for submodule path".
plugins/marketplaces/

# Claude Code 插件管理器的本地状态，含本机绝对路径，不进版本控制
plugins/installed_plugins.json
plugins/known_marketplaces.json
plugins/install-counts-cache.json
